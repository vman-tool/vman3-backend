# Redis (caching + websocket pub/sub). The dev stack in
# docker-compose.dev.yml starts redis with --requirepass vman@1029 and maps
# it to host port 6370, so a backend running on the host needs both values.
# Celery uses REDIS_CELERY_URL instead, reaching redis by service name
# inside the compose network.
REDIS_URL=redis://localhost:6370
# Celery broker as seen from wherever the API process runs. The code defaults
# this to redis://redis:6379, which only resolves inside the compose network,
# so a backend running on the host cannot dispatch tasks without it. The
# containers override it back to the service name in docker-compose.dev.yml.
REDIS_CELERY_URL=redis://localhost:6370
REDIS_PASSWORD=vman@1029
