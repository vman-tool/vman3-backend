
DEFAULT_PROJECT_ID=2
ODK_API_URL=https://your-odk-central-instance.example.com
ODK_API_VERSION=v1
ODK_USERNAME=changeme@example.com
ODK_PASSWORD=changeme

#ACCOUNT DEFAULT INFORMATION
DEFAULT_ACCOUNT_NAME=admin
DEFAULT_ACCOUNT_EMAIL=changeme@example.com
DEFAULT_ACCOUNT_PASSWORD=changeme

ARANGODB_URL=http://localhost:8529
DB_NAME=vman3
DB_PASSWORD=changeme
ARANGO_ROOT_PASSWORD=changeme

CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,'*'

APP_NANE=VMan3
DEBUG=True
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme

# SMTP Local Config
USE_CREDENTIALS=False

# JWT Secret - generate with: openssl rand -hex 32
JWT_SECRET=changeme
REFRESH_TOKEN_EXPIRE_MINUTES=15
ACCESS_TOKEN_EXPIRE_MINUTES=10

# Redis (caching + websocket pub/sub). The dev stack in
# docker-compose.dev.yml starts redis with --requirepass <password> and maps
# it to host port 6370, so a backend running on the host needs both values.
# Celery uses REDIS_CELERY_URL instead, reaching redis by service name
# inside the compose network.
REDIS_URL=redis://localhost:6370
# Celery broker as seen from wherever the API process runs. The code defaults
# this to redis://redis:6379, which only resolves inside the compose network,
# so a backend running on the host cannot dispatch tasks without it. The
# containers override it back to the service name in docker-compose.dev.yml.
REDIS_CELERY_URL=redis://localhost:6370
REDIS_PASSWORD=changeme
